##[group]Run set -uo pipefail
set -uo pipefail
# NOT `set -e`: the gate's non-zero exit is a VERDICT, not a crash. The step must still
# write the summary, upload the result and hand the verdict to the last step, which is the
# single place the check turns red (GitHub starts this shell with -e; it is cleared here).
set +e
ARGS=()
while IFS= read -r g; do [ -n "$g" ] && ARGS+=(--receipt-glob "$g"); done <<< "$RECEIPT_GLOBS"
if [ "$BUILD_GRAPH" = "true" ]; then ARGS+=(--build-graph); fi
if [ -n "${EVENT_PATH:-}" ] && [ -f "$EVENT_PATH" ]; then ARGS+=(--event-file "$EVENT_PATH"); fi
if [ -n "${VERIFIER_JOB:-}" ]; then ARGS+=(--verifier-job "$VERIFIER_JOB"); fi
if [ -n "${VERIFIER_CONCLUSION:-}" ]; then ARGS+=(--verifier-conclusion "$VERIFIER_CONCLUSION"); fi
ARGS+=(--verifier-output-ref "$VERIFIER_OUTPUT_REF")
if [ -n "${SIGNING_KEY_FINGERPRINT:-}" ]; then ARGS+=(--signing-key-fingerprint "$SIGNING_KEY_FINGERPRINT"); fi
python3 "${TOOLS_PATH}/tools/graph/ci_gate.py" run \
  --repo . \
  --repo-name "$REPO_NAME" \
  --tools "$TOOLS_PATH" \
  --program-ref "$PROGRAM_REF" \
  --base "$RANGE_BASE" \
  --head "$RANGE_HEAD" \
  --pr-body-file "${RUNNER_TEMP}/graph-admission/pr-body.txt" \
  --enforcement "$ENFORCEMENT" \
  --workdir "${RUNNER_TEMP}/graph-admission" \
  --out "${RUNNER_TEMP}/graph-admission/graph-admission-result.json" \
  --summary "${GITHUB_STEP_SUMMARY}" \
  "${ARGS[@]}"
RC=$?
echo "rc=$RC" >> "$GITHUB_OUTPUT"
exit 0
