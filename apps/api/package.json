{
  "name": "@muneral/api",
  "version": "0.4.6",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "test": "pnpm run test:types && pnpm run test:unit && pnpm run test:battery-suite",
    "//test:types": "ts-jest typechecked every spec on every run; vitest transforms with swc, which strips types without checking them. Without this script the 65 vitest suites would be the first code in this repo that CI never typechecks. It runs FIRST because that is the order ts-jest enforced.",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --passWithNoTests",
    "//test:battery-suite": "test/assembly stays on jest — see vitest.config.ts `exclude`. NODE_OPTIONS is set HERE and not inherited: the suite is ESM and jest needs the flag to load it.",
    "test:battery-suite": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@muneral/types": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "29.7.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "1.16.2",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "dotenv": "^17.0.0",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "pg": "^8.23.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  },
  "type": "module"
}
