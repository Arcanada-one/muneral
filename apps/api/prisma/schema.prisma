// Muneral Arcana — Prisma schema
// Hand-authored from apps/api/migrations/1713100000000-InitialSchema.ts
// Enums stored as String + @db.VarChar with CHECK constraints in migration SQL.
// Do NOT use `db pull` — hand-authoring is the source of truth.
//
// Mapping decisions:
// - WorkspaceMember.user FK → User via WorkspaceMember.userId (not User.apiKeys dual-FK)
// - ApiKey.agent FK only → Agent (original schema: api_keys.agent_id FK agents)
// - ActivityLog.actorId is polymorphic (human OR agent) — Prisma cannot model polymorphic FK;
//   stored as plain String (no @@relation), consistent with actor_type discriminator.
// - TaskGitRef FK → tasks only (task_id); project relation removed (original has no project_id col).
// - Milestone.dueDate and Sprint.startDate/endDate stored as String
//   (ISO-8601 date strings, matching TypeORM entity usage).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// users
// ---------------------------------------------------------------------------
model User {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  githubId   BigInt?  @unique @map("github_id")
  telegramId BigInt?  @unique @map("telegram_id")
  name       String   @db.VarChar
  avatarUrl  String?  @map("avatar_url") @db.VarChar
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// workspaces
// ---------------------------------------------------------------------------
model Workspace {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug             String   @unique @db.VarChar
  name             String   @db.VarChar
  ownerId          String   @map("owner_id") @db.Uuid
  subscriptionTier String   @default("free") @map("subscription_tier") @db.VarChar
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  projects       Project[]
  agents         Agent[]
  activityLogs   ActivityLog[]
  webhookConfigs WebhookConfig[]
  usageLimits    UsageLimits?

  @@map("workspaces")
}

// ---------------------------------------------------------------------------
// workspace_members
// ---------------------------------------------------------------------------
model WorkspaceMember {
  workspaceId String @map("workspace_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  // role CHECK (role IN ('owner','manager','developer','viewer')) added in migration
  role        String @db.VarChar

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// projects
// ---------------------------------------------------------------------------
model Project {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  slug        String   @db.VarChar
  name        String   @db.VarChar
  description String?  @db.Text
  repoUrl     String?  @map("repo_url") @db.VarChar
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  sprints    Sprint[]
  tasks      Task[]
  migrationBatches MigrationBatch[]

  @@map("projects")
}

// ---------------------------------------------------------------------------
// milestones
// ---------------------------------------------------------------------------
model Milestone {
  id        String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  title     String  @db.VarChar
  dueDate   String? @map("due_date")
  // status: 'open' | 'closed' — no enum constraint in InitialSchema
  status    String  @default("open") @db.VarChar

  // Relations
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprints Sprint[]

  @@map("milestones")
}

// ---------------------------------------------------------------------------
// sprints
// ---------------------------------------------------------------------------
model Sprint {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  milestoneId String? @map("milestone_id") @db.Uuid
  name        String  @db.VarChar
  startDate   String  @map("start_date")
  endDate     String  @map("end_date")
  // status CHECK (status IN ('planned','active','completed')) in migration
  status      String  @default("planned") @db.VarChar

  // Relations
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@map("sprints")
}

// ---------------------------------------------------------------------------
// tasks
// ---------------------------------------------------------------------------
model Task {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  sprintId      String?  @map("sprint_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  title         String   @db.VarChar
  description   String?  @db.Text
  // status CHECK (status IN ('todo','in_progress','review','blocked','done','cancelled')) in migration
  status        String   @default("todo") @db.VarChar
  // priority CHECK (priority IN ('critical','high','medium','low')) in migration
  priority      String   @default("medium") @db.VarChar
  dueDate       String?  @map("due_date")
  estimateHours Decimal? @map("estimate_hours") @db.Decimal(6, 2)
  createdById   String?  @map("created_by_id") @db.Uuid
  // actor_type CHECK (actor_type IN ('human','agent')) in migration
  actorType     String?  @map("actor_type") @db.VarChar
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // MUN-0040 — migration import provenance.
  // importedAt is when the row entered Muneral; the HISTORICAL task date lives
  // on SourceOccurrence.historicalAt and is never overwritten by it.
  importedAt     DateTime? @map("imported_at") @db.Timestamptz()
  /// MIG-003 write-once bootstrap provenance receipt (DB trigger enforced).
  bootstrapStamp Json?     @map("bootstrap_stamp")
  /// Optimistic revision for the migration CAS transition path. Only that path
  /// bumps it; every pre-existing writer leaves it at 0.
  revision       Int       @default(0)

  // Relations
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint         Sprint?                   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent         Task?                     @relation("TaskChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       Task[]                    @relation("TaskChildren")
  tags           TaskTag[]
  checklists     TaskChecklist[]
  depsFrom       TaskDependency[]          @relation("DepsFrom")
  depsTo         TaskDependency[]          @relation("DepsTo")
  agents         TaskAgent[]
  activityLogs   ActivityLog[]
  gitRefs        TaskGitRef[]
  executionState TaskExecutionState?
  attempts       TaskExecutionAttempt[]
  transitions    TaskExecutionTransition[]
  outboxEvents   TaskOutboxEvent[]
  resultBindings TaskResultBinding[]
  resultNodes    TaskResultNode[]
  resultRefs     TaskCommittedResultRef[]
  solutionLogHeadReceipts SolutionLogHeadReceipt[]
  legacyIdentities        LegacyIdentity[]

  @@index([projectId], name: "idx_tasks_project_id")
  @@index([sprintId], name: "idx_tasks_sprint_id")
  @@index([status], name: "idx_tasks_status")
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// task_tags
// ---------------------------------------------------------------------------
model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tag    String @db.VarChar

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tag])
  @@map("task_tags")
}

// ---------------------------------------------------------------------------
// task_checklists
// ---------------------------------------------------------------------------
model TaskChecklist {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  text      String   @db.VarChar
  checked   Boolean  @default(false)
  position  Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_checklists")
}

// ---------------------------------------------------------------------------
// task_dependencies
// ---------------------------------------------------------------------------
model TaskDependency {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fromTaskId String @map("from_task_id") @db.Uuid
  toTaskId   String @map("to_task_id") @db.Uuid
  // type CHECK (type IN ('depends_on','blocks','related_to','duplicates')) in migration
  type       String @db.VarChar

  // Relations
  fromTask Task @relation("DepsFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("DepsTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@map("task_dependencies")
}

// ---------------------------------------------------------------------------
// agents
// ---------------------------------------------------------------------------
model Agent {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  name         String   @db.VarChar
  model        String?  @db.VarChar
  provider     String?  @db.VarChar
  capabilities Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKeys    ApiKey[]
  taskAgents TaskAgent[]
  solutionLogHeadReceipts SolutionLogHeadReceipt[]

  @@map("agents")
}

// ---------------------------------------------------------------------------
// api_keys
// ---------------------------------------------------------------------------
model ApiKey {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  agentId    String    @map("agent_id") @db.Uuid
  keyHash    String    @map("key_hash") @db.VarChar
  label      String?   @db.VarChar
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId], name: "idx_api_keys_agent_id")
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// task_agents
// ---------------------------------------------------------------------------
model TaskAgent {
  taskId     String   @map("task_id") @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  // role CHECK (role IN ('lead','reviewer','executor')) in migration
  role       String   @db.VarChar
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  // Relations
  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([taskId, agentId])
  @@index([agentId], name: "idx_task_agents_agent_id")
  @@map("task_agents")
}

// ---------------------------------------------------------------------------
// activity_log
// ---------------------------------------------------------------------------
// actorId is polymorphic (references either users.id or agents.id, discriminated
// by actorType). Prisma does not support polymorphic FKs — stored as plain String.
// The DB-level FK in the original schema does not exist either (actor_id has no FK).
model ActivityLog {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  // actor_type CHECK (actor_type IN ('human','agent')) in migration
  actorType   String   @map("actor_type") @db.VarChar
  // actorId is polymorphic — no FK relation, plain UUID stored as string
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([taskId], name: "idx_activity_log_task_id")
  @@index([workspaceId], name: "idx_activity_log_workspace_id")
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// webhook_configs
// ---------------------------------------------------------------------------
model WebhookConfig {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  url         String   @db.VarChar
  events      String[] @default([])
  secret      String?  @db.VarChar
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("webhook_configs")
}

// ---------------------------------------------------------------------------
// task_git_refs
// ---------------------------------------------------------------------------
// Note: task_git_refs.task_id FK → tasks only (InitialSchema has no project_id col here).
// ProjectsService manages git refs but queries by task_id, not project_id.
model TaskGitRef {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  // type CHECK (type IN ('repo','branch','commit')) in migration
  type      String   @db.VarChar
  url       String   @db.VarChar
  ref       String?  @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_git_refs")
}

// ---------------------------------------------------------------------------
// usage_limits (scaffold)
// ---------------------------------------------------------------------------
model UsageLimits {
  workspaceId      String @id @map("workspace_id") @db.Uuid
  maxAgents        Int    @default(-1) @map("max_agents")
  maxProjects      Int    @default(-1) @map("max_projects")
  maxTasksPerMonth Int    @default(-1) @map("max_tasks_per_month")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("usage_limits")
}

// ---------------------------------------------------------------------------
// task_field_state — per-field versioned hash storage
// ---------------------------------------------------------------------------
// No Prisma relation to Task — FK ON DELETE CASCADE enforced via migration SQL.
// version is a monotonic counter bumped on every value change (not on no-op writes).
model TaskFieldState {
  taskId    String   @map("task_id") @db.Uuid
  fieldName String   @map("field_name") @db.VarChar(64)
  hash      String   @db.VarChar(64)
  version   BigInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@id([taskId, fieldName])
  @@index([taskId, version])
  @@map("task_field_state")
}

// ---------------------------------------------------------------------------
// agent_field_reads — per-agent per-field read watermark
// ---------------------------------------------------------------------------
// No Prisma relations — taskId/agentId referenced logically; FK enforced via migration SQL.
model AgentFieldRead {
  agentId         String   @map("agent_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  fieldName       String   @map("field_name") @db.VarChar(64)
  lastSeenVersion BigInt   @map("last_seen_version")
  lastSeenHash    String   @map("last_seen_hash") @db.VarChar(64)
  acknowledgedAt  DateTime @map("acknowledged_at") @db.Timestamptz()

  @@id([agentId, taskId, fieldName])
  @@map("agent_field_reads")
}

// ---------------------------------------------------------------------------
// muneral_kb_task_changes — durable task graph change registry
// ---------------------------------------------------------------------------
// Intentionally has no FK to Task: task deletions must leave a tombstone that
// the Muneral-to-KB synchronizer can consume after the domain row is gone.
model MuneralKbTaskChange {
  taskId    String   @id @map("task_id") @db.Uuid
  revision  BigInt
  changedAt DateTime @map("changed_at") @db.Timestamptz()
  deleted   Boolean  @default(false)

  @@map("muneral_kb_task_changes")
}

// ---------------------------------------------------------------------------
// MUN-0020 execution-authority — additive models extending Task
// ---------------------------------------------------------------------------
// These models add execution authority without replacing Task or its current
// status machine. They are disabled-by-default (not wired into AppModule).

// One row per task — the task-scoped execution aggregate root.
model TaskExecutionState {
  taskId           String    @id @map("task_id") @db.Uuid
  aggregateVersion BigInt    @map("aggregate_version")
  currentAttemptId String?   @map("current_attempt_id") @db.Uuid
  retryBudget      Int       @map("retry_budget")
  retryCount       Int       @map("retry_count")
  retryBackoffMs   BigInt    @map("retry_backoff_ms")
  retryEligibleAt  DateTime? @map("retry_eligible_at") @db.Timestamptz()

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@map("task_execution_state")
}

// One row per Muneral-issued execution attempt.
model TaskExecutionAttempt {
  attemptId   String    @id @map("attempt_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  ordinal     Int
  status      String    @db.VarChar(32)
  issuedAt    DateTime  @map("issued_at") @db.Timestamptz()
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  // Relations
  task           Task                      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  transitions    TaskExecutionTransition[]
  outboxEvents   TaskOutboxEvent[]
  resultBindings TaskResultBinding[]
  resultNodes    TaskResultNode[]
  resultRefs     TaskCommittedResultRef[]
  solutionLogHeadReceipts SolutionLogHeadReceipt[]

  @@unique([taskId, ordinal])
  @@unique([attemptId, taskId])
  @@index([taskId])
  @@map("task_execution_attempts")
}

// One immutable row per transition fact — append-only journal.
model TaskExecutionTransition {
  id                String   @id @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  aggregateVersion  BigInt   @map("aggregate_version")
  eventType         String   @map("event_type") @db.VarChar(64)
  idempotencyKey    String   @map("idempotency_key") @db.VarChar(256)
  commandDigest     String   @map("command_digest") @db.VarChar(64)
  transitionPayload Json     @default("{}") @map("transition_payload")
  committedResult   Json     @default("{}") @map("committed_result")
  evidenceRefs      Json     @default("[]") @map("evidence_refs")
  causationId       String   @map("causation_id") @db.VarChar(256)
  correlationId     String   @map("correlation_id") @db.VarChar(256)
  recordedAt        DateTime @map("recorded_at") @db.Timestamptz()

  // Relations
  task        Task                    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempt     TaskExecutionAttempt    @relation(fields: [attemptId, taskId], references: [attemptId, taskId], onDelete: Restrict)
  outboxEvent TaskOutboxEvent?
  resultRef   TaskCommittedResultRef?

  @@unique([taskId, aggregateVersion])
  @@unique([taskId, idempotencyKey])
  @@unique([id, taskId])
  @@index([taskId])
  @@index([attemptId])
  @@map("task_execution_transitions")
}

// ---------------------------------------------------------------------------
// MUN-0021 outbox-relay — additive models extending MUN-0020 execution authority
// ---------------------------------------------------------------------------
// Typed outbox events atomically committed with authority transitions.
// Mutable lease bookkeeping, append-only delivery-attempt and quarantine
// evidence, and durable consumer inbox/deduplication.
// Disabled-by-default (not wired into AppModule).

// One row per committed authority transition — server-derived from the
// transition and aggregate state. Callers cannot choose routing or payload.
// Immutable after insert — append-only trigger enforced via migration SQL.
model TaskOutboxEvent {
  id               String   @id @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  aggregateVersion BigInt   @map("aggregate_version")
  attemptId        String   @map("attempt_id") @db.Uuid
  transitionId     String   @map("transition_id") @db.Uuid
  eventType        String   @map("event_type") @db.VarChar(64)
  eventPayload     Json     @default("{}") @map("event_payload")
  recordedAt       DateTime @map("recorded_at") @db.Timestamptz()

  // Relations
  task             Task                      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempt          TaskExecutionAttempt      @relation(fields: [attemptId, taskId], references: [attemptId, taskId], onDelete: Restrict)
  transition       TaskExecutionTransition   @relation(fields: [transitionId, taskId], references: [id, taskId], onDelete: Restrict)
  lease            OutboxLease?
  deliveryAttempts DeliveryAttemptEvidence[]
  quarantines      QuarantineEvidence[]
  inboxEntries     ConsumerInbox[]

  @@unique([taskId, transitionId])
  @@unique([transitionId, taskId])
  @@unique([transitionId])
  @@index([taskId])
  @@index([attemptId])
  @@index([recordedAt])
  @@map("task_outbox_events")
}

// Mutable delivery bookkeeping — one row per outbox event.
// This is the ONLY table whose rows are updated during normal operation.
// Lease acquisition is a single-writer atomic UPDATE with RETURNING.
// Fenced: every mutation must match lease_holder + delivery_ordinal so a
// stale worker cannot commit a status change after the lease was reclaimed.
// The migration also installs a database trigger that permits only
// pending -> leased -> delivered|quarantined (or unchanged status).
model OutboxLease {
  outboxEventId   String    @id @map("outbox_event_id") @db.Uuid
  leaseHolder     String?   @map("lease_holder") @db.VarChar(128)
  leaseAcquiredAt DateTime? @map("lease_acquired_at") @db.Timestamptz()
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz()
  deliveryStatus  String    @default("pending") @map("delivery_status") @db.VarChar(32)
  deliveryOrdinal Int       @default(0) @map("delivery_ordinal")
  failureCount    Int       @default(0) @map("failure_count")
  lastErrorCode   String?   @map("last_error_code") @db.VarChar(64)

  // Relations
  outboxEvent TaskOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@map("outbox_leases")
}

// Append-only record of each dispatch attempt.
// UPDATE and DELETE rejected by database trigger.
model DeliveryAttemptEvidence {
  id              String   @id @db.Uuid
  outboxEventId   String   @map("outbox_event_id") @db.Uuid
  deliveryOrdinal Int      @map("delivery_ordinal")
  disposition     String   @db.VarChar(32)
  consumerDigest  String?  @map("consumer_digest") @db.VarChar(64)
  errorDetail     Json?    @map("error_detail")
  attemptedAt     DateTime @map("attempted_at") @db.Timestamptz()

  // Relations
  outboxEvent TaskOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@index([outboxEventId])
  @@map("delivery_attempt_evidence")
}

// Append-only poison record — one row per quarantined event.
// UPDATE and DELETE rejected by database trigger.
model QuarantineEvidence {
  id              String   @id @db.Uuid
  outboxEventId   String   @map("outbox_event_id") @db.Uuid
  deliveryOrdinal Int      @map("delivery_ordinal")
  failureCount    Int      @map("failure_count")
  lastErrorCode   String?  @map("last_error_code") @db.VarChar(64)
  lastErrorDetail Json?    @map("last_error_detail")
  quarantinedAt   DateTime @map("quarantined_at") @db.Timestamptz()

  // Relations
  outboxEvent TaskOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([outboxEventId])
  @@map("quarantine_evidence")
}

// Durable deduplication boundary per consumer.
// Append-only — UPDATE/DELETE rejected by database trigger. Application
// code has no mutation path after insert.
model ConsumerInbox {
  consumerId       String   @map("consumer_id") @db.VarChar(128)
  outboxEventId    String   @map("outbox_event_id") @db.Uuid
  consumedAt       DateTime @map("consumed_at") @db.Timestamptz()
  sideEffectDigest String   @map("side_effect_digest") @db.VarChar(64)

  // Relations
  outboxEvent TaskOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@id([consumerId, outboxEventId])
  @@unique([consumerId, outboxEventId])
  @@map("consumer_inbox")
}

// ---------------------------------------------------------------------------
// MUN-0021 adoption gate — Muneral-owned committed-result nodes and references
// ---------------------------------------------------------------------------
// Ratified in the ARCA-0194 result-reference consilium. Muneral authors the
// reference and the deterministic completion receipt in the same transaction
// as the accepted node mutation, transition journal, aggregate update and
// outbox fact. Execution adapters propose mutations; they never author
// receipts or supply authoritative digests.
// Disabled-by-default (not wired into AppModule).

// Pre-existing, trusted assignment of one Task Card projection/principal to
// an execution attempt. Result adapters have read-only access through the
// commit seam and cannot create or update this fact.
model TaskResultBinding {
  taskId           String   @map("task_id") @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  cardId           String   @map("card_id") @db.VarChar(256)
  cardDigest       String   @map("card_digest") @db.VarChar(64)
  projectionId     String   @map("projection_id") @db.VarChar(256)
  projectionDigest String   @map("projection_digest") @db.VarChar(64)
  principalId      String   @map("principal_id") @db.VarChar(256)
  recordedAt       DateTime @map("recorded_at") @db.Timestamptz()

  task       Task                     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempt    TaskExecutionAttempt     @relation(fields: [attemptId, taskId], references: [attemptId, taskId], onDelete: Restrict)
  resultRefs TaskCommittedResultRef[]

  @@id([taskId, attemptId, cardId])
  @@unique([taskId, attemptId, cardId, cardDigest, projectionId, projectionDigest, principalId])
  @@index([attemptId])
  @@map("task_result_bindings")
}

// One row per accepted owned mutation of a Task Card result node.
// Append-only — a new result is a new node version, never an in-place rewrite.
model TaskResultNode {
  id           String   @id @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  attemptId    String   @map("attempt_id") @db.Uuid
  cardId       String   @map("card_id") @db.VarChar(256)
  nodeId       String   @map("node_id") @db.VarChar(256)
  nodeVersion  Int      @map("node_version")
  mutationId   String   @map("mutation_id") @db.VarChar(256)
  principalId  String   @map("principal_id") @db.VarChar(256)
  nodePayload  Json     @map("node_payload")
  resultDigest String   @map("result_digest") @db.VarChar(64)
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz()

  // Relations
  task       Task                     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempt    TaskExecutionAttempt     @relation(fields: [attemptId, taskId], references: [attemptId, taskId], onDelete: Restrict)
  resultRefs TaskCommittedResultRef[]

  @@unique([id, taskId])
  @@unique([taskId, nodeId, nodeVersion])
  @@unique([taskId, mutationId])
  @@index([taskId, nodeId])
  @@index([attemptId])
  @@map("task_result_nodes")
}

// One row per committed result — the closed CommittedResultRefV0 identity plus
// the deterministic completion-receipt identity. The receipt is a pure
// function of these columns, so a receipt exists exactly when its reference
// does. The reference carries no result body: the committed node bytes live in
// TaskResultNode and are addressed by resultDigest.
model TaskCommittedResultRef {
  resultRefId      String   @id @map("result_ref_id") @db.VarChar(64)
  taskId           String   @map("task_id") @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  cardId           String   @map("card_id") @db.VarChar(256)
  cardDigest       String   @map("card_digest") @db.VarChar(64)
  projectionId     String   @map("projection_id") @db.VarChar(256)
  projectionDigest String   @map("projection_digest") @db.VarChar(64)
  nodeId           String   @map("node_id") @db.VarChar(256)
  nodeVersion      Int      @map("node_version")
  resultDigest     String   @map("result_digest") @db.VarChar(64)
  mutationId       String   @map("mutation_id") @db.VarChar(256)
  mutationDigest   String   @map("mutation_digest") @db.VarChar(64)
  principalId      String   @map("principal_id") @db.VarChar(256)
  transitionId     String   @map("transition_id") @db.Uuid
  aggregateVersion BigInt   @map("aggregate_version")
  resultNodeId     String   @map("result_node_id") @db.Uuid
  receiptId        String   @map("receipt_id") @db.VarChar(64)
  causationId      String   @map("causation_id") @db.VarChar(256)
  correlationId    String   @map("correlation_id") @db.VarChar(256)
  recordedAt       DateTime @map("recorded_at") @db.Timestamptz()

  // Relations
  task       Task                    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempt    TaskExecutionAttempt    @relation(fields: [attemptId, taskId], references: [attemptId, taskId], onDelete: Restrict)
  transition TaskExecutionTransition @relation(fields: [transitionId, taskId], references: [id, taskId], onDelete: Restrict)
  resultNode TaskResultNode          @relation(fields: [resultNodeId, taskId], references: [id, taskId], onDelete: Restrict)
  binding    TaskResultBinding       @relation(fields: [taskId, attemptId, cardId, cardDigest, projectionId, projectionDigest, principalId], references: [taskId, attemptId, cardId, cardDigest, projectionId, projectionDigest, principalId], onDelete: Restrict)

  @@unique([transitionId])
  @@unique([transitionId, taskId])
  @@unique([taskId, attemptId, cardId, nodeId, nodeVersion])
  @@unique([taskId, mutationId])
  @@unique([receiptId])
  @@index([taskId, cardId])
  @@index([recordedAt])
  @@map("task_committed_result_refs")
}

// ARCA-0198: producer-authenticated provenance for one accepted SolutionLog
// head. This append-only fact is not a completion receipt and cannot authorize
// model use.
model SolutionLogHeadReceipt {
  receiptId                 String   @id @map("receipt_id") @db.VarChar(64)
  taskId                    String   @map("task_id") @db.Uuid
  attemptId                 String   @map("attempt_id") @db.Uuid
  principalId               String   @map("principal_id") @db.Uuid
  taskRevision              BigInt   @map("task_revision")
  projectionDigestSha256    String   @map("projection_digest_sha256") @db.VarChar(64)
  logRevision               Int      @map("log_revision")
  previousHeadDigestSha256  String?  @map("previous_head_digest_sha256") @db.VarChar(64)
  headDigestSha256          String   @map("head_digest_sha256") @db.VarChar(64)
  solutionLogDigestSha256   String   @map("solution_log_digest_sha256") @db.VarChar(64)
  executionAggregateVersion BigInt   @map("execution_aggregate_version")
  producerVersion           Int      @map("producer_version")
  recordedAt                DateTime @map("recorded_at") @db.Timestamptz()
  provenanceScope           String   @map("provenance_scope") @db.VarChar(64)
  modelUseStatus            String   @map("model_use_status") @db.VarChar(32)

  task      Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempt   TaskExecutionAttempt @relation(fields: [attemptId, taskId], references: [attemptId, taskId], onDelete: Restrict)
  principal Agent                @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@unique([taskId, attemptId, producerVersion])
  @@unique([taskId, attemptId, logRevision])
  @@unique([taskId, attemptId, headDigestSha256])
  @@index([recordedAt])
  @@index([principalId])
  @@map("solution_log_head_receipts")
}

// ---------------------------------------------------------------------------
// MUN-0040 — migration import surface (AUP-DAT-002 / AUP-DAT-003)
// ---------------------------------------------------------------------------

/// One idempotent unit of migration work plus its commit receipt.
model MigrationBatch {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  batchKey       String    @unique @map("batch_key") @db.VarChar(200)
  sourceSetEpoch String    @map("source_set_epoch") @db.VarChar(120)
  producer       String    @db.VarChar(200)
  projectId      String    @map("project_id") @db.Uuid
  // status CHECK (status IN ('open','committed','failed')) in migration SQL
  status         String    @default("open") @db.VarChar(16)
  requestDigest  String    @map("request_digest") @db.VarChar(64)
  receipt        Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  committedAt    DateTime? @map("committed_at") @db.Timestamptz()

  // Relations
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  occurrences SourceOccurrence[]

  @@index([projectId], name: "idx_migration_batches_project_id")
  @@index([status], name: "idx_migration_batches_status")
  @@map("migration_batches")
}

/// The LOGICAL task behind one (source_namespace, legacy_id) pair.
/// The unique constraint is AUP-DAT-002's core guarantee: `ARAS-0001` in a
/// nested tracker and `ARAS-0001` in the root workspace are two identities.
model LegacyIdentity {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sourceNamespace String    @map("source_namespace") @db.VarChar(300)
  legacyId        String    @map("legacy_id") @db.VarChar(200)
  /// Null until the identity is bound to a Muneral WorkItem.
  taskId          String?   @map("task_id") @db.Uuid
  // mapping_kind CHECK (mapping_kind IN ('same','split','merge','candidate_conflict'))
  mappingKind     String    @default("same") @map("mapping_kind") @db.VarChar(24)
  /// Optimistic revision; bumped only by an explicit identity decision.
  mappingRevision Int       @default(0) @map("mapping_revision")
  decidedBy       String?   @map("decided_by") @db.VarChar(200)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  // Relations
  task         Task?              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  occurrences  SourceOccurrence[]
  mappingsFrom IdentityMapping[]  @relation("MappingFrom")
  mappingsTo   IdentityMapping[]  @relation("MappingTo")

  @@unique([sourceNamespace, legacyId])
  @@index([legacyId], name: "idx_legacy_identities_legacy_id")
  @@index([taskId], name: "idx_legacy_identities_task_id")
  @@map("legacy_identities")
}

/// Append-only source receipt: one sighting of one identity in one source.
model SourceOccurrence {
  id                     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  legacyIdentityId       String    @map("legacy_identity_id") @db.Uuid
  batchId                String    @map("batch_id") @db.Uuid
  sourceRoot             String    @map("source_root") @db.VarChar(500)
  sourceLocator          String    @map("source_locator") @db.VarChar(1000)
  /// Stable key for an anonymous record; must not be a bare line number.
  sourceKey              String    @map("source_key") @db.VarChar(300)
  contentDigest          String    @map("content_digest") @db.VarChar(64)
  capturedAt             DateTime  @map("captured_at") @db.Timestamptz()
  /// The raw status verbatim from the source, never rewritten.
  historicalStatus       String    @map("historical_status") @db.VarChar(64)
  historicalAssertedDone Boolean   @default(false) @map("historical_asserted_done")
  // current_verification CHECK IN ('not_revalidated','revalidated_done','revalidated_not_done')
  currentVerification    String    @default("not_revalidated") @map("current_verification") @db.VarChar(32)
  /// The historical time the source states — never the import time.
  historicalAt           DateTime? @map("historical_at") @db.Timestamptz()
  rawExcerpt             String?   @map("raw_excerpt") @db.Text
  recordedAt             DateTime  @default(now()) @map("recorded_at") @db.Timestamptz()

  // Relations
  identity LegacyIdentity @relation(fields: [legacyIdentityId], references: [id], onDelete: Restrict)
  batch    MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([legacyIdentityId, sourceLocator, contentDigest])
  @@index([legacyIdentityId], name: "idx_source_occurrences_identity")
  @@index([batchId], name: "idx_source_occurrences_batch")
  @@index([recordedAt], name: "idx_source_occurrences_recorded_at")
  @@map("source_occurrences")
}

/// Append-only reverse mapping for same/split/merge/candidate_conflict.
model IdentityMapping {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fromIdentityId  String   @map("from_identity_id") @db.Uuid
  toIdentityId    String   @map("to_identity_id") @db.Uuid
  // kind CHECK (kind IN ('same','split','merge','candidate_conflict'))
  kind            String   @db.VarChar(24)
  mappingRevision Int      @map("mapping_revision")
  basis           String   @db.Text
  decidedBy       String   @map("decided_by") @db.VarChar(200)
  decidedAt       DateTime @default(now()) @map("decided_at") @db.Timestamptz()

  // Relations
  fromIdentity LegacyIdentity @relation("MappingFrom", fields: [fromIdentityId], references: [id], onDelete: Restrict)
  toIdentity   LegacyIdentity @relation("MappingTo", fields: [toIdentityId], references: [id], onDelete: Restrict)

  @@unique([fromIdentityId, toIdentityId, mappingRevision])
  @@index([fromIdentityId], name: "idx_identity_mappings_from")
  @@index([toIdentityId], name: "idx_identity_mappings_to")
  @@map("identity_mappings")
}

/// Replay store for keyed import/transition requests. Holds only committed
/// responses — the authoritative work item stays in `tasks`.
model MigrationIdempotencyRecord {
  // scope CHECK (scope IN ('work_item','transition'))
  scope          String   @db.VarChar(32)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(200)
  requestDigest  String   @map("request_digest") @db.VarChar(64)
  response       Json
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz()

  @@id([scope, idempotencyKey])
  @@map("migration_idempotency_records")
}
