{
  "version": "credential-policy-v0",
  "rules": [
    { "id": "openai_style", "pattern": "(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{3,}", "flags": "i" },
    { "id": "github_pat", "pattern": "github_pat_[A-Za-z0-9_]{20,}", "flags": "i" },
    { "id": "github_token", "pattern": "gh[pousr]_[A-Za-z0-9]{20,}", "flags": "i" },
    { "id": "bearer", "pattern": "Bearer\\s+[^\\s]+", "flags": "i" },
    { "id": "api_key_marker", "pattern": "(^|[^A-Za-z0-9])api[_-]?key[:=_-]", "flags": "i" },
    { "id": "akid_marker", "pattern": "akid-", "flags": "i" },
    { "id": "generic_base64", "pattern": "(^|[^A-Za-z0-9+/])[A-Za-z0-9+/]{40,}={0,2}($|[^A-Za-z0-9+/=])", "flags": "" },
    { "id": "jwt", "pattern": "(^|[^A-Za-z0-9])eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}", "flags": "" },
    { "id": "slack", "pattern": "(^|[^A-Za-z0-9])xox[abprs]-[A-Za-z0-9-]{10,}", "flags": "" },
    { "id": "aws_access_key", "pattern": "(^|[^A-Za-z0-9])AKIA[0-9A-Z]{16}", "flags": "" },
    { "id": "gitlab_pat", "pattern": "(^|[^A-Za-z0-9])glpat-[A-Za-z0-9_-]{15,}", "flags": "" }
  ]
}
