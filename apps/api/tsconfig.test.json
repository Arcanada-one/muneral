{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "jest",
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      "@muneral/types": [
        "../../packages/types/dist/index"
      ]
    },
    "outDir": "./dist-test",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // The mutation harness and the fixture generator are plain .js and stay that
    // way — they run as scripts under node, not through the test transform. They
    // used to be require()d, which needed no declarations; the ESM move made them
    // `import`s, and without allowJs each one is TS7016 "could not find a
    // declaration file … implicitly has an 'any' type". Inferring from the source
    // beats hand-written .d.ts files that would silently drift from it. checkJs
    // stays off: these two files are not being type-checked, only read for their
    // shapes.
    "allowJs": true
  },
  // A2-304c: the two runner configs are typechecked HERE and not by tsconfig.json.
  // tsconfig.json emits to dist/ and that tree is what the production image carries —
  // a test-runner config has no business in it. This project emits nothing (it is run
  // with --noEmit by `pnpm run test:types`), so it is where they belong.
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "jest.config.mjs"
  ]
}
