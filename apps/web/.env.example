# CI-injected metadata and paths for browser fixtures (activity visible-count + repository-destination).
# These are not production defaults or credentials; live environments must not set fixture values.
ACTIVITY_COUNT_CANDIDATE_SHA=
ACTIVITY_COUNT_OUTPUT_ROOT=
ACTIVITY_COUNT_PRIVATE_ROOT=
CHROME_PATH=
GITHUB_RUN_ATTEMPT=
GITHUB_RUN_ID=
GITHUB_SHA=
GITHUB_WORKSPACE=
REPOSITORY_DESTINATION_CANDIDATE_SHA=
REPOSITORY_DESTINATION_OUTPUT_ROOT=
REPOSITORY_DESTINATION_PRIVATE_ROOT=
REPOSITORY_DESTINATION_RUN_ATTEMPT=
REPOSITORY_DESTINATION_RUN_ID=
RUNNER_TEMP=

# Optional local HTTP consumer canary. Unset means the live-only tests are skipped.
# Points to a protected JSON fixture generated for an isolated loopback API;
# it is a test input location, never a production credential or task artifact store.
MUN_ARTIFACT_CANARY_FIXTURE=
