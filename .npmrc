public-hoist-pattern[]=@prisma/*
# prisma.config.ts is at the workspace root and imports prisma/config. The API
# declares the CLI as a production dependency. pnpm reserves its root dev name;
# the production Docker stage links that same locked API CLI for root imports.
public-hoist-pattern[]=prisma
shamefully-hoist=false
only-built-dependencies=@nestjs/core,bcrypt,esbuild,msgpackr-extract,sharp,unrs-resolver
