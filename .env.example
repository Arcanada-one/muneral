# Muneral API — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env

# App
NODE_ENV=production
PORT=3500

# Bind address (A2-255). Unset or empty means 127.0.0.1 — loopback only. Set it ONLY when the
# process must answer on another interface, and understand what that opens: before A2-255 the API
# bound every interface unconditionally, and on a host whose ufw admits the tailscale mesh that
# published it to every peer.
#
# DO NOT set this in a CONTAINER environment file. The image already sets HOST=0.0.0.0, which is
# what a published port needs; a loopback value here binds the CONTAINER's own loopback, so the
# in-container healthcheck (`wget http://localhost:3500/health`) still passes while nothing outside
# the container can reach the API — healthy and unreachable at the same time.
# HOST=127.0.0.1

# Commit baked into the image at build time so GET /health can name it (A2-255). NOT set here and
# NOT set by hand: docker-compose.prod.yml passes `${BUILD_SHA:-}` as a build arg and the root
# deploy broker exports BUILD_SHA from the checkout it controls. A hand-started instance leaves it
# unset and /health then reports build.sha: null with a reason — not_measured, never a pass.
# MUNERAL_BUILD_SHA=

# Database (Arcana DB server)
DATABASE_URL=postgresql://muneral_app:CHANGE_ME@135.181.222.38:5432/arcanada_muneral

# Redis (Arcana DB server)
REDIS_URL=redis://:CHANGE_ME@135.181.222.38:6379
REDIS_PREFIX=muneral:

# JWT
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# GitHub OAuth (create at github.com/organizations/Arcanada-one/settings/applications)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.muneral.com/auth/github/callback

# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# API Key prefix (informational, used in key generation)
API_KEY_PREFIX=mun_sk_

# Muneral Web URL (for CORS)
WEB_URL=https://app.muneral.com

# Rate limiting
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_API_PER_SEC=30

# Outbox relay (A2-370, AEV E03.03). Wired into the API, but cycles run only when
# OUTBOX_RELAY_ENABLED is exactly "true"; anything else leaves outbox events pending.
OUTBOX_RELAY_ENABLED=false
OUTBOX_RELAY_INTERVAL_MS=5000
