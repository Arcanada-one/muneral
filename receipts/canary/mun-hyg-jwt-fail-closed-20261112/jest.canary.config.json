{
  "rootDir": "/repo/apps/api",
  "roots": [
    "/spec"
  ],
  "testRegex": "jwt-(unset|set)\\.canary\\.spec\\.ts$",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts",
    "mjs"
  ],
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "/repo/apps/api/tsconfig.test.json",
        "useESM": true,
        "diagnostics": false
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@nestjs/throttler$": "/repo/apps/api/test/support/throttler-test-double.ts",
    "^@muneral/types$": "/repo/packages/types/dist/index.js"
  },
  "modulePaths": [
    "/repo/apps/api/node_modules",
    "/repo/apps/web/node_modules"
  ],
  "setupFiles": [
    "/repo/apps/api/test/setup-env.ts"
  ],
  "testEnvironment": "node",
  "cacheDirectory": "/tmp/jest-cache"
}
